size = Vector2(540, 419.99997)
expression = "float closest = 999.0;
for (int i = 0; i < count; i++) {
    vec2 note_uv = texture(tex, vec2((float(i) + 0.5) / 16.0, 0.5)).rg;
    vec2 diff = uv - note_uv;
    diff.x *= aspect;
    float d = length(diff);
    closest = min(closest, d);
}
min_dist = closest;"

